# ── Maven 构建产物 ──
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── 编译产物 ──
*.class
*.jar
*.war
*.ear
*.nar

# ── IDE：IntelliJ IDEA ──
.idea/
*.iml
*.ipr
*.iws
out/

# ── IDE：VS Code ──
.vscode/

# ── 敏感配置（绝对不要提交密钥/密码）──
application-local.yml
application-local.properties
application-secret.yml
application-secret.properties
.env
*.env
secrets.yml
secrets.properties

# ── 日志文件 ──
*.log
logs/
log/

# ── Spring Boot 进程文件 ──
*.pid

# ── 操作系统生成文件 ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── JVM 崩溃日志 ──
hs_err_pid*
replay_pid*

# -- 视频文件 --
data/
